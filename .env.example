# Локальная разработка. Скопируйте в .env: cp .env.example .env
# Не храните реальные секреты в репозитории.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=agregator
POSTGRES_PASSWORD=agregator
POSTGRES_DB=agregator
POSTGRES_PORT=5432

# --- API (apps/api) ---
DATABASE_URL=postgresql://agregator:agregator@localhost:5432/agregator?schema=public
API_PORT=4000
# Через запятую: точные origin'ы, которым разрешён CORS (в production только https).
# Пусто = браузерам с других origin запрещено всё (web обращается к API с сервера).
CORS_ORIGINS=http://localhost:3000
# Сколько доверенных reverse proxy стоит перед API (число) или их адреса через запятую.
# Пусто = X-Forwarded-For игнорируется. Значение true запрещено. См. docs/DEPLOYMENT.md.
TRUST_PROXY=

# --- Web (apps/web) ---
# Адрес API, к которому обращается сервер Next.js
API_URL=http://localhost:4000

# --- Тесты API: отдельная БД, имя обязано оканчиваться на _test ---
TEST_DATABASE_URL=postgresql://agregator:agregator@localhost:5432/agregator_test?schema=public
