# Скопируйте в deploy/.env и заполните. Файл deploy/.env не коммитится.

# --- База данных ---
POSTGRES_USER=agregator
# Обязательно: длинный случайный пароль из букв и цифр (подставляется в URL базы):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=agregator

# Демо-заказы в каталоге (для закрытого теста удобно true; в боевом запуске обязательно false:
# демо-сид выполняется при каждом обновлении).
SEED_DEMO=true

# --- Локальный запуск без домена ---
# Сайт откроется на http://localhost:3000
PUBLIC_ORIGIN=http://localhost:3000
WEB_TRUST_PROXY_HOPS=0

# --- Запуск на домене (docker-compose.proxy.yml) ---
# Раскомментируйте и замените пример своим доменом:
# DOMAIN=remont.example.ru
# PUBLIC_ORIGIN=https://remont.example.ru
# WEB_TRUST_PROXY_HOPS=1
# Логин и пароль тестировщиков для закрытого теста (страница /gate «Вход для тестировщиков»).
# Хеш создаётся командой:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ваш-пароль'
# Значение хеша обязательно в одинарных кавычках (в нём есть символы $).
# BASIC_AUTH_USER=tester
# BASIC_AUTH_HASH='$2a$14$...'

# --- Сборка образов ---
# Если при сборке apt-get не может скачать пакеты с deb.debian.org (Connection timed out),
# укажите доверенное зеркало Debian с /debian и /debian-security, только http://,
# например: DEBIAN_MIRROR=http://mirror.yandex.ru (подробности — deploy/README.md).
# DEBIAN_MIRROR=

# --- Внутренняя сеть Docker (менять, только если подсеть занята на сервере) ---
# BACKEND_SUBNET=172.31.250.0/24
# WEB_BACKEND_IP=172.31.250.10

# --- Лимиты запросов (в минуту на IP), по умолчанию ---
# RATE_LIMIT_PER_MIN=120
# AUTH_RATE_LIMIT_PER_MIN=10
# WRITE_RATE_LIMIT_PER_MIN=30

# --- Вход через банк (Сбер ID, Т-Банк ID), deploy/README.md «Вход через банк» ---
# Включает deploy/docker-compose.bank-login.yml: API получает выход к серверам банка.
# Адрес сайта для возврата из банка — PUBLIC_ORIGIN (тот же адрес регистрируется у банка).
# BANK_LOGIN=true
# Сбер ID: ключи с developers.sber.ru, сертификат .p12 и корневой сертификат УЦ Минцифры
# кладутся в deploy/secrets (папка не коммитится), пути — внутри контейнера:
# SBER_ID_CLIENT_ID=
# SBER_ID_CLIENT_SECRET=
# SBER_ID_CERT_PATH=/run/secrets/bank/sber-id.p12
# SBER_ID_CERT_PASSWORD=
# SBER_ID_CA_PATH=/run/secrets/bank/russian_trusted_root_ca.pem
# Т-Банк ID: ключи приходят по договору (tid@tbank.ru):
# TBANK_ID_CLIENT_ID=
# TBANK_ID_CLIENT_SECRET=

# --- Уведомления владельцу (deploy/README.md, «Уведомления и обслуживание») ---
# Бот Telegram: токен от @BotFather и id чата; и/или вебхук (POST {"text": "..."}).
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT=
# NOTIFY_WEBHOOK_URL=
# Heartbeat внешнего монитора (healthchecks.io и т. п.) после успешного обновления, копии и
# проверки восстановления:
# DEPLOY_HEARTBEAT_URL=
# BACKUP_HEARTBEAT_URL=
# RESTORE_HEARTBEAT_URL=
# Почасовая проверка: адрес пингуется, если всё в порядке, и <адрес>/fail при проблемах.
# Монитор поднимает тревогу, если пинга нет больше 2 часов — так видно и падение всего сервера.
# MONITOR_HEARTBEAT_URL=

# --- Резервные копии (deploy/README.md, «Резервные копии») ---
# BACKUP_DIR=/var/backups/agregator
# BACKUP_KEEP_DAYS=14
# Копия вне сервера: публичный ключ age (age1...) и место rclone (remote:bucket/path).
# BACKUP_AGE_RECIPIENT=
# BACKUP_RCLONE_REMOTE=
# true — копия без выгрузки вне сервера считается сбоем (обязательно до публичного запуска).
# BACKUP_REQUIRE_OFFSITE=true
