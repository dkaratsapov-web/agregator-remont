# Caddy получает и продлевает сертификат Let's Encrypt для DOMAIN автоматически.
# X-Forwarded-For от клиента не принимается (trusted_proxies не задан): Caddy записывает
# в него реальный IP посетителя, web берёт его при WEB_TRUST_PROXY_HOPS=1.
{$DOMAIN} {
	encode zstd gzip

	# Закрытое тестирование: без пароля открыта только главная (лендинг без данных приложения;
	# вошедшему пользователю она показывает только его имя) и её статические файлы. Всё приложение (каталог, вход,
	# кабинет, /_next/image и прочее) за паролем, пока не выполнены условия публичного запуска
	# (docs/SECURITY.md, раздел 8). Для полного открытия убрать matcher и блок basic_auth.
	# /_next/static/* — неизменяемые сборочные файлы (JS, CSS, шрифты) всего приложения: в них
	# код интерфейса, но нет данных и секретов (серверный код туда не попадает).
	# Без пароля разрешено только чтение (GET, HEAD): Next.js принимает Server Actions
	# POST-запросом на любой адрес, в том числе на «/», поэтому POST на открытые адреса тоже
	# идёт через пароль, иначе вход, регистрация и действия кабинета обходили бы его.
	@private not {
		method GET HEAD
		path / /offline /sw.js /robots.txt /manifest.webmanifest /icon.svg /apple-icon.png /icons/* /_next/static/*
	}
	basic_auth @private {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy web:3000
}
