{
  "name": "agregator-remont",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agregator/shared build && pnpm --parallel --filter @agregator/api --filter @agregator/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @agregator/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @agregator/shared build && pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @agregator/api db:migrate",
    "db:deploy": "pnpm --filter @agregator/api db:deploy",
    "db:seed": "pnpm --filter @agregator/api db:seed",
    "smoke": "node scripts/smoke.mjs",
    "start": "dotenv -e .env -- pnpm --parallel --filter @agregator/api --filter @agregator/web start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
