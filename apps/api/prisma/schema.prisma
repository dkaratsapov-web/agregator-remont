generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Значения enum'ов синхронизированы с packages/shared/src/jobs.ts
// (проверяется тестом src/jobs/contract.spec.ts).
enum JobCategory {
  REPAIR_TURNKEY
  PLUMBING
  ELECTRICAL
  TILING
  FINISHING
  FLOORING
  ROOFING
  WINDOWS_DOORS
  DESIGN
  OTHER
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// Синхронизировано с JOB_CLOSE_OUTCOMES в packages/shared/src/jobs.ts.
enum JobCloseOutcome {
  COMPLETED
  CANCELLED
}

enum Currency {
  RUB
}

enum AuditAction {
  JOB_CREATED
  JOB_UPDATED
  JOB_CLOSED
  JOB_STARTED
  BID_CREATED
  BID_WITHDRAWN
  BID_ACCEPTED
  BID_REJECTED
  PROFILE_UPDATED
  LEAD_PROCESSED
  LEAD_REOPENED
  USER_ROLE_CHANGED
  PASSWORD_CHANGED
  SESSIONS_REVOKED
  PLAN_SAVED
  PLAN_AUTHOR_CHANGED
  PLAN_PROPOSED
  PLAN_APPROVED
  PLAN_RETURNED
  STAGE_SUBMITTED
  STAGE_ACCEPTED
  STAGE_REWORK
  CONTRACTOR_QUIT
  REPORT_CREATED
  REPORT_RESOLVED
  CONTENT_HIDDEN
  CONTENT_RESTORED
  USER_BLOCKED
  USER_UNBLOCKED
  PASSWORD_RESET_ISSUED
  PASSWORD_RESET_DONE
  REVIEW_CREATED
  FLAG_RESOLVED
}

// Синхронизировано с BID_STATUSES в packages/shared/src/bids.ts.
enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Синхронизировано с BID_REJECT_REASONS в packages/shared/src/bids.ts.
enum BidRejectReason {
  OTHER_ACCEPTED
  JOB_CLOSED
}

// Синхронизировано с USER_ROLES в packages/shared/src/auth.ts.
enum UserRole {
  CUSTOMER
  CONTRACTOR
  ADMIN
}

model Job {
  id            String           @id @default(cuid())
  title         String           @db.VarChar(160)
  description   String
  category      JobCategory
  city          String           @db.VarChar(100)
  /// Целые рубли; null — «по договорённости». Ограничения проверяются CHECK в миграции.
  budgetMin     Int?             @map("budget_min")
  budgetMax     Int?             @map("budget_max")
  currency      Currency         @default(RUB)
  status        JobStatus        @default(OPEN)
  /// Чем закончился заказ: выполнен или отменён. Задаётся при закрытии; null — не закрыт или
  /// закрыт до появления поля.
  closeOutcome  JobCloseOutcome? @map("close_outcome")
  /// Ответы анкеты категории ({ id вопроса: значение }); проверяются validateJobDetails из
  /// @agregator/shared. Объект и размер ограничены CHECK в миграции.
  details       Json             @default("{}")
  /// Позиции других категорий: [{ category, details }], до 4 (job-items.ts). Проверяются
  /// validateJobItems; массив и размер ограничены CHECK в миграции.
  extraItems    Json             @default("[]") @map("extra_items")
  /// Все категории заказа: основная первой, затем дополнительные. Заполняет триггер базы из
  /// category и extraItems (писать не нужно); по ней ищет каталог (GIN-индекс).
  categories    JobCategory[]    @default([])
  /// Заказчик-владелец. null у демонстрационных заказов из сида.
  ownerId       String?          @map("owner_id")
  /// Restrict: удаление пользователя не должно молча удалять или «осиротить» его заказы.
  owner         User?            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bids          Bid[]
  plan          JobPlan?
  messages      JobMessage[]
  photos        JobPhoto[]
  notifications Notification[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  /// Ключ формы публикации (UUID): повтор того же запроса (двойной клик, обрыв связи) вернёт
  /// уже созданный заказ, а не создаст второй. Уникален в пределах владельца.
  requestId     String?          @map("request_id") @db.Uuid
  /// SHA-256 содержимого публикации с этим ключом: повтор с другим содержимым — 409.
  requestHash   String?          @map("request_hash") @db.VarChar(64)
  /// Скрыт модератором: не виден в каталоге и посторонним, откликаться нельзя. null — виден.
  hiddenAt      DateTime?        @map("hidden_at")
  reports       Report[]
  review        Review?
  favorites     FavoriteJob[]
  contentFlags  ContentFlag[]

  @@unique([ownerId, requestId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([categories], type: Gin)
  /// Поиск каталога ILIKE '%…%' и город без учёта регистра (расширение pg_trgm в миграции).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_description_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_city_trgm_idx")
  // Частичный индекс открытых заказов (jobs_open_created_at_idx) Prisma не описывает: он только
  // в SQL миграции 20261019120000_catalog_search_indexes.
  @@map("jobs")
}

/// Черновик нового заказа: виден только владельцу, в каталог не попадает. Поля могут быть
/// пустыми; полная проверка — при публикации, когда черновик превращается в заказ и удаляется.
model JobDraft {
  id          String       @id @default(cuid())
  ownerId     String       @map("owner_id")
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String?      @db.VarChar(160)
  description String?
  category    JobCategory?
  city        String?      @db.VarChar(100)
  budgetMin   Int?         @map("budget_min")
  budgetMax   Int?         @map("budget_max")
  /// Ответы анкеты, проверенные мягко (неверные отброшены). Объект и размер — CHECK в миграции.
  details     Json         @default("{}")
  /// Позиции других категорий, проверенные мягко.
  extraItems  Json         @default("[]") @map("extra_items")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("job_drafts")
}

model User {
  id               String             @id @default(cuid())
  /// Короткий номер для пользователя и поддержки («ID 100245»). Ничего не открывает: доступ
  /// только по сессии. Последовательность с 100001 (миграция user_public_id).
  publicId         Int                @unique @default(autoincrement()) @map("public_id")
  /// Хранится в нижнем регистре после trim; уникальность обеспечивает индекс.
  email            String             @unique @db.VarChar(254)
  /// argon2id в PHC-формате. Никогда не попадает в ответы API.
  passwordHash     String             @map("password_hash")
  name             String             @db.VarChar(80)
  role             UserRole
  /// +7XXXXXXXXXX (CHECK в базе), необязательный.
  phone            String?            @db.VarChar(12)
  city             String?            @db.VarChar(80)
  /// Время последней загрузки фото; null — фото нет. Само фото в user_avatars.
  avatarUpdatedAt  DateTime?          @map("avatar_updated_at")
  /// Оформление кабинета (значения проверяет CHECK в базе и DTO).
  uiTheme          String             @default("light") @map("ui_theme") @db.VarChar(10)
  uiScale          String             @default("normal") @map("ui_scale") @db.VarChar(10)
  uiMotion         String             @default("system") @map("ui_motion") @db.VarChar(10)
  /// Заблокирован администратором: вход запрещён, сессии отозваны. null — активен.
  blockedAt        DateTime?          @map("blocked_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  avatar           UserAvatar?
  sessions         Session[]
  jobs             Job[]
  jobDrafts        JobDraft[]
  auditLogs        AuditLog[]
  profile          ContractorProfile?
  bids             Bid[]
  /// Входы через банки (Сбер ID, Т-Банк ID), привязанные к аккаунту.
  externalAccounts ExternalAccount[]
  messagesWritten  JobMessage[]       @relation("JobMessageAuthor")
  dealMessages     JobMessage[]       @relation("JobMessageContractor")
  photosUploaded   JobPhoto[]         @relation("JobPhotoUploader")
  dealPhotos       JobPhoto[]         @relation("JobPhotoContractor")
  notifications    Notification[]
  reportsFiled     Report[]           @relation("ReportReporter")
  reportsResolved  Report[]           @relation("ReportResolver")
  passwordResets   PasswordReset[]    @relation("PasswordResetUser")
  resetsIssued     PasswordReset[]    @relation("PasswordResetIssuer")
  reviewsWritten   Review[]           @relation("ReviewAuthor")
  reviewsReceived  Review[]           @relation("ReviewContractor")
  favoriteJobs     FavoriteJob[]
  contentFlags     ContentFlag[]      @relation("ContentFlagAuthor")
  flagsResolved    ContentFlag[]      @relation("ContentFlagResolver")

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  /// SHA-256 (hex) от токена; сам токен в БД не хранится.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Браузер и система, например «Chrome, Windows» (из User-Agent при входе).
  device     String?   @db.VarChar(80)
  /// Последняя активность, обновляется не чаще раза в час.
  lastSeenAt DateTime? @map("last_seen_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ExternalProvider {
  SBER
  TBANK
}

/// Аккаунт пользователя у банка, через который он входит (Сбер ID, Т-Банк ID). Субъект —
/// постоянный идентификатор человека у банка (sub); токены банка не хранятся.
model ExternalAccount {
  id        String           @id @default(cuid())
  provider  ExternalProvider
  subject   String           @db.VarChar(255)
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([provider, subject])
  /// Один аккаунт каждого банка на пользователя.
  @@unique([userId, provider])
  @@map("external_accounts")
}

/// Журнал изменений: кто, что и когда изменил. Пишется в той же транзакции, что и изменение.
/// Не содержит секретов; персональные данные — только идентификатор автора.
model AuditLog {
  id         String      @id @default(cuid())
  /// SetNull: запись журнала переживает удаление пользователя.
  actorId    String?     @map("actor_id")
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(40)
  entityId   String      @map("entity_id")
  /// { field: { from, to } } только для изменённых полей.
  changes    Json
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Профиль подрядчика (1:1 с пользователем роли CONTRACTOR).
model ContractorProfile {
  userId          String        @id @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  about           String        @default("")
  categories      JobCategory[]
  cities          String[]
  experienceYears Int?          @map("experience_years")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("contractor_profiles")
}

/// Отклик подрядчика на заказ. Один отклик подрядчика на заказ (уникальный индекс).
model Bid {
  id           String           @id @default(cuid())
  jobId        String           @map("job_id")
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  contractorId String           @map("contractor_id")
  contractor   User             @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  /// Целые рубли.
  price        Int
  durationDays Int?             @map("duration_days")
  comment      String
  status       BidStatus        @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  /// Когда заказчик изменил заказ после этого отклика (описание, бюджет, анкету…): подрядчик
  /// видит пометку «заказ изменён после вашего отклика». null — не менялся.
  jobChangedAt DateTime?        @map("job_changed_at")
  /// Почему отклик отклонён: выбран другой исполнитель или заказ закрыт. null — не отклонён.
  rejectReason BidRejectReason? @map("reject_reason")
  /// Скрыт модератором: заказчик его не видит и не может выбрать. null — виден.
  hiddenAt     DateTime?        @map("hidden_at")

  @@unique([jobId, contractorId])
  @@index([contractorId, createdAt(sort: Desc)])
  @@index([jobId, status])
  @@map("bids")
}

/// Заявка на участие в закрытом тестировании (форма на главной). Персональные данные:
/// доступ только у администраторов, согласие фиксируется версией политики.
/// Сторона сделки: заказчик-владелец или выбранный исполнитель.
enum PlanParty {
  OWNER
  CONTRACTOR
}

enum JobPlanStatus {
  DRAFT
  PROPOSED
  APPROVED
}

enum JobStageStatus {
  PLANNED
  SUBMITTED
  ACCEPTED
  REWORK
}

/// План работ по заказу в работе (packages/shared/src/plans.ts). Один на заказ; при отказе
/// исполнителя удаляется вместе с этапами (история — в журнале).
model JobPlan {
  id           String        @id @default(cuid())
  jobId        String        @unique @map("job_id")
  /// Cascade: прежний код, удаляя заказ, не упрётся в план (проверка миграций).
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Кто составляет план; другая сторона согласует. Меняет заказчик, пока план не согласован.
  author       PlanParty     @default(CONTRACTOR)
  /// true — этапы сдаются строго по порядку.
  sequential   Boolean       @default(true)
  status       JobPlanStatus @default(DRAFT)
  /// Растёт при каждом изменении плана: правка с устаревшей версией — 409.
  version      Int           @default(1)
  returnReason String?       @map("return_reason")
  proposedAt   DateTime?     @map("proposed_at")
  approvedAt   DateTime?     @map("approved_at")
  stages       JobStage[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("job_plans")
}

model JobStage {
  id            String         @id @default(cuid())
  planId        String         @map("plan_id")
  plan          JobPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// С 1, порядок сдачи.
  position      Int
  title         String         @db.VarChar(120)
  description   String         @default("")
  durationDays  Int?           @map("duration_days")
  status        JobStageStatus @default(PLANNED)
  submitComment String?        @map("submit_comment")
  reworkComment String?        @map("rework_comment")
  submittedAt   DateTime?      @map("submitted_at")
  acceptedAt    DateTime?      @map("accepted_at")
  /// Фото-отчёт к сдачам этапа.
  photos        JobPhoto[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([planId, position])
  @@map("job_stages")
}

model Lead {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(80)
  /// +7XXXXXXXXXX
  phone          String    @db.VarChar(12)
  consentVersion String    @map("consent_version") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")

  @@index([createdAt(sort: Desc)])
  @@index([phone, createdAt])
  @@map("leads")
}

/// Фото профиля: перекодировано в WebP 512×512 без метаданных. Отдельная таблица, чтобы байты
/// не читались вместе с пользователем при каждой проверке сессии.
model UserAvatar {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_avatars")
}

/// Сообщение переписки по заказу. Переписка своя для каждой сделки (заказ + исполнитель): после
/// отказа исполнителя новый исполнитель прежнюю не видит. Внешние ключи — Cascade (проверка
/// миграций: прежний код, удаляя заказ или пользователя, не упрётся в новые строки).
model JobMessage {
  id           String     @id @default(cuid())
  jobId        String     @map("job_id")
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Исполнитель сделки, к которой относится переписка.
  contractorId String     @map("contractor_id")
  contractor   User       @relation("JobMessageContractor", fields: [contractorId], references: [id], onDelete: Cascade)
  authorId     String     @map("author_id")
  author       User       @relation("JobMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// До 2000 символов; пустой — только если приложено фото (проверяет API).
  body         String     @default("")
  /// Ключ отправки из формы: повтор той же отправки (двойной клик, обрыв связи) не создаёт копию.
  requestId    String?    @map("request_id") @db.VarChar(64)
  /// SHA-256 текста и исходных файлов отправки с этим ключом: повтор с другим содержимым — 409.
  requestHash  String?    @map("request_hash") @db.VarChar(64)
  /// Скрыто модератором: вместо текста и фото — пометка. null — видно.
  hiddenAt     DateTime?  @map("hidden_at")
  photos       JobPhoto[]
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([authorId, requestId])
  @@index([jobId, contractorId, createdAt])
  @@map("job_messages")
}

/// Фото к сообщению или к сдаче этапа (ровно к одному из них — CHECK в миграции). Перекодировано
/// в WebP без метаданных; байты — в job_photo_blobs, чтобы не читаться вместе со списками.
model JobPhoto {
  id           String        @id @default(cuid())
  jobId        String        @map("job_id")
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Исполнитель сделки: фото видят он, заказчик и администратор.
  contractorId String        @map("contractor_id")
  contractor   User          @relation("JobPhotoContractor", fields: [contractorId], references: [id], onDelete: Cascade)
  uploaderId   String        @map("uploader_id")
  uploader     User          @relation("JobPhotoUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  stageId      String?       @map("stage_id")
  stage        JobStage?     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  messageId    String?       @map("message_id")
  message      JobMessage?   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Размер полного фото, px, и его вес в байтах.
  width        Int
  height       Int
  bytes        Int
  blob         JobPhotoBlob?
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([stageId])
  @@index([messageId])
  @@index([jobId])
  @@map("job_photos")
}

/// Байты фото: полное (до 2000 px) и миниатюра (до 480 px), WebP. Хранятся в базе, поэтому
/// попадают в копии и проверку восстановления вместе с остальными данными (docs/JOB_CHAT.md).
model JobPhotoBlob {
  photoId String   @id @map("photo_id")
  photo   JobPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  full    Bytes
  thumb   Bytes

  @@map("job_photo_blobs")
}

// Синхронизировано с NOTIFICATION_KINDS в packages/shared/src/notifications.ts.
enum NotificationKind {
  BID_RECEIVED
  BID_WITHDRAWN
  BID_ACCEPTED
  BID_REJECTED
  PLAN_PROPOSED
  PLAN_APPROVED
  PLAN_RETURNED
  PLAN_AUTHOR_CHANGED
  STAGE_SUBMITTED
  STAGE_ACCEPTED
  STAGE_REWORK
  CONTRACTOR_QUIT
  JOB_CLOSED
  MESSAGE
}

/// Уведомление в кабинете: событие по заказу для другой стороны. Пишется в транзакции события.
/// Непрочитанные новые сообщения по заказу — одна строка со счётчиком (частичный уникальный
/// индекс в миграции), прочитанные остаются в истории.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String           @map("job_id")
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  /// Сколько событий собрано (новые сообщения); 1..10000 — CHECK в миграции.
  count     Int              @default(1)
  /// Снимок подробностей (NotificationData): объект, не больше 1 КБ — CHECK в миграции.
  data      Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  /// Время последнего события (у собранных сообщений сдвигается вперёд).
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([jobId])
  // Частичные индексы Prisma не описывает, они только в SQL миграции
  // 20261022100000_notifications: notifications_unread_idx (непрочитанные по пользователю и
  // заказу) и notifications_message_unread_key (одна непрочитанная строка сообщений на заказ).
  @@map("notifications")
}

// Синхронизировано с REPORT_TARGETS, REPORT_REASONS, REPORT_STATUSES в packages/shared/src/moderation.ts.
enum ReportTarget {
  JOB
  MESSAGE
  BID
}

enum ReportReason {
  SPAM
  FRAUD
  ABUSE
  FAKE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Жалоба пользователя на заказ, сообщение или отклик. Одна открытая жалоба автора на один
/// предмет (частичный уникальный индекс в миграции). Разбирает администратор.
model Report {
  id             String       @id @default(cuid())
  reporterId     String       @map("reporter_id")
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTarget @map("target_type")
  /// id заказа, сообщения или отклика.
  targetId       String       @map("target_id")
  /// Заказ, к которому относится предмет жалобы.
  jobId          String       @map("job_id")
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason         ReportReason
  comment        String       @default("")
  status         ReportStatus @default(OPEN)
  /// Решение администратора.
  note           String?
  resolvedById   String?      @map("resolved_by_id")
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?    @map("resolved_at")
  /// Пожаловавшийся видел решение (раздел «Мои жалобы»). null — решение ещё не просмотрено.
  reporterSeenAt DateTime?    @map("reporter_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId, createdAt])
  @@index([jobId])
  // Частичный уникальный индекс reports_open_key (одна открытая жалоба автора на предмет) —
  // только в SQL миграции 20261023100000_moderation.
  @@map("reports")
}

/// Одноразовая ссылка для нового пароля (почты нет: ссылку выдаёт администратор или команда на
/// сервере). Хранится только SHA-256 токена; срок — PASSWORD_RESET_LIMITS.TTL_HOURS.
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  /// Администратор, выдавший ссылку; null — выдана командой на сервере.
  issuedById String?   @map("issued_by_id")
  issuedBy   User?     @relation("PasswordResetIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

/// Отзыв заказчика об исполнителе: один на выполненный заказ. Ограничения — CHECK в миграции.
model Review {
  id           String    @id @default(cuid())
  jobId        String    @unique @map("job_id")
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId     String    @map("author_id")
  author       User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  contractorId String    @map("contractor_id")
  contractor   User      @relation("ReviewContractor", fields: [contractorId], references: [id], onDelete: Cascade)
  rating       Int       @db.SmallInt
  text         String    @default("")
  /// Скрыт модератором: не показывается и не входит в рейтинг.
  hiddenAt     DateTime? @map("hidden_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([contractorId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// Избранные заказы (закладки в каталоге).
model FavoriteJob {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String   @map("job_id")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, jobId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorite_jobs")
}

/// Автопроверка: в сообщении или отклике похоже на контакты (телефон, почта, ссылка, мессенджер).
/// Текст отправляется, администратор видит пометку в очереди и решает.
model ContentFlag {
  id           String       @id @default(cuid())
  targetType   ReportTarget @map("target_type")
  targetId     String       @map("target_id")
  jobId        String       @map("job_id")
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId     String       @map("author_id")
  author       User         @relation("ContentFlagAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Что найдено: PHONE, EMAIL, LINK, MESSENGER (через запятую).
  kinds        String       @db.VarChar(64)
  status       ReportStatus @default(OPEN)
  resolvedById String?      @map("resolved_by_id")
  resolvedBy   User?        @relation("ContentFlagResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@unique([targetType, targetId])
  @@index([status, createdAt])
  @@map("content_flags")
}
