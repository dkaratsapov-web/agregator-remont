generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Значения enum'ов синхронизированы с packages/shared/src/jobs.ts
// (проверяется тестом src/jobs/contract.spec.ts).
enum JobCategory {
  REPAIR_TURNKEY
  PLUMBING
  ELECTRICAL
  TILING
  FINISHING
  FLOORING
  ROOFING
  WINDOWS_DOORS
  DESIGN
  OTHER
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum Currency {
  RUB
}

enum AuditAction {
  JOB_CREATED
  JOB_UPDATED
  JOB_CLOSED
  JOB_STARTED
  BID_CREATED
  BID_WITHDRAWN
  BID_ACCEPTED
  BID_REJECTED
  PROFILE_UPDATED
  LEAD_PROCESSED
  LEAD_REOPENED
  USER_ROLE_CHANGED
}

// Синхронизировано с BID_STATUSES в packages/shared/src/bids.ts.
enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Синхронизировано с USER_ROLES в packages/shared/src/auth.ts.
enum UserRole {
  CUSTOMER
  CONTRACTOR
  ADMIN
}

model Job {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(160)
  description String
  category    JobCategory
  city        String      @db.VarChar(100)
  /// Целые рубли; null — «по договорённости». Ограничения проверяются CHECK в миграции.
  budgetMin   Int?        @map("budget_min")
  budgetMax   Int?        @map("budget_max")
  currency    Currency    @default(RUB)
  status      JobStatus   @default(OPEN)
  /// Заказчик-владелец. null у демонстрационных заказов из сида.
  ownerId     String?     @map("owner_id")
  /// Restrict: удаление пользователя не должно молча удалять или «осиротить» его заказы.
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bids        Bid[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("jobs")
}

model User {
  id           String    @id @default(cuid())
  /// Хранится в нижнем регистре после trim; уникальность обеспечивает индекс.
  email        String    @unique @db.VarChar(254)
  /// argon2id в PHC-формате. Никогда не попадает в ответы API.
  passwordHash String    @map("password_hash")
  name         String    @db.VarChar(80)
  role         UserRole
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  jobs         Job[]
  auditLogs    AuditLog[]
  profile      ContractorProfile?
  bids         Bid[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 (hex) от токена; сам токен в БД не хранится.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Журнал изменений: кто, что и когда изменил. Пишется в той же транзакции, что и изменение.
/// Не содержит секретов; персональные данные — только идентификатор автора.
model AuditLog {
  id         String      @id @default(cuid())
  /// SetNull: запись журнала переживает удаление пользователя.
  actorId    String?     @map("actor_id")
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(40)
  entityId   String      @map("entity_id")
  /// { field: { from, to } } только для изменённых полей.
  changes    Json
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Профиль подрядчика (1:1 с пользователем роли CONTRACTOR).
model ContractorProfile {
  userId          String        @id @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  about           String        @default("")
  categories      JobCategory[]
  cities          String[]
  experienceYears Int?          @map("experience_years")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("contractor_profiles")
}

/// Отклик подрядчика на заказ. Один отклик подрядчика на заказ (уникальный индекс).
model Bid {
  id           String    @id @default(cuid())
  jobId        String    @map("job_id")
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  contractorId String    @map("contractor_id")
  contractor   User      @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  /// Целые рубли.
  price        Int
  durationDays Int?      @map("duration_days")
  comment      String
  status       BidStatus @default(PENDING)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([jobId, contractorId])
  @@index([contractorId, createdAt(sort: Desc)])
  @@index([jobId, status])
  @@map("bids")
}

/// Заявка на участие в закрытом тестировании (форма на главной). Персональные данные:
/// доступ только у администраторов, согласие фиксируется версией политики.
model Lead {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(80)
  /// +7XXXXXXXXXX
  phone          String    @db.VarChar(12)
  consentVersion String    @map("consent_version") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")

  @@index([createdAt(sort: Desc)])
  @@index([phone, createdAt])
  @@map("leads")
}
